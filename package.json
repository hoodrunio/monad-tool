{
  "name": "monad-validator-analytics",
  "version": "1.0.0",
  "description": "High-performance validator analytics and monitoring system for Monad blockchain",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "schema:init": "ts-node scripts/init-schema.ts",
    "demo:process-logs": "ts-node scripts/demo-process-logs.ts",
    "docker:build": "docker build -t monad-analytics .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "monad",
    "blockchain",
    "validator",
    "analytics",
    "monitoring",
    "consensus",
    "clickhouse",
    "redis"
  ],
  "author": "Monad Analytics Team",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^0.2.5",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "ws": "^8.14.2",
    "joi": "^17.11.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "@types/express": "^4.17.20",
    "@types/cors": "^2.8.16",
    "@types/compression": "^1.7.5",
    "@types/ws": "^8.5.8",
    "@types/uuid": "^9.0.7",
    "@types/joi": "^17.2.3",
    "@types/lodash": "^4.14.200",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/monad/validator-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/monad/validator-analytics/issues"
  },
  "homepage": "https://github.com/monad/validator-analytics#readme"
} 