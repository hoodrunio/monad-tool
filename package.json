{
  "name": "monad-validator-analytics",
  "version": "1.0.0",
  "description": "High-performance validator analytics and monitoring system for Monad blockchain",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "health": "ts-node scripts/health-check.ts",
    "schema:init": "ts-node scripts/init-schema.ts",
    "demo:process-logs": "ts-node scripts/demo-process-logs.ts",
    "api:start": "ts-node scripts/start-api.ts",
    "api:dev": "ts-node --watch src/api/main.ts",
    "api:build": "tsc && node dist/api/main.js",
    "api:test": "ts-node scripts/test-api.ts",
    "api:fix": "ts-node scripts/fix-api-issues.ts",
    "query:setup": "ts-node scripts/setup-query-monitoring.ts",
    "clear-api-cache": "ts-node scripts/clear-api-cache.ts",
    "sample:database": "ts-node scripts/sample-database-data.ts",
    "sample:run": "./scripts/run-database-sample.sh",
    "docker:build": "docker build -t monad-analytics .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "monad",
    "blockchain",
    "validator",
    "analytics",
    "monitoring",
    "consensus",
    "clickhouse",
    "redis"
  ],
  "author": "Monad Analytics Team",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^0.2.5",
    "axios": "^1.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "toml": "^3.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.8",
    "@types/joi": "^17.2.3",
    "@types/lodash": "^4.14.200",
    "@types/node": "^20.19.1",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoodrunio/monad-tool.git"
  },
  "bugs": {
    "url": "https://github.com/hoodrunio/monad-tool/issues"
  },
  "homepage": "https://github.com/hoodrunio/monad-tool#readme"
}
