[Unit]
Description=Monad Explorer Query Node
After=network.target monad-processor.service
Requires=monad-processor.service

[Service]
Type=simple
User=your_user
Group=your_group
WorkingDirectory=/path/to/your/monad-explorer
ExecStart=/usr/bin/npm run query-node:start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monad-query-node

[Install]
WantedBy=multi-user.target 