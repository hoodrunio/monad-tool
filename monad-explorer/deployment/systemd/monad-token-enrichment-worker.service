[Unit]
Description=Monad Explorer Token Enrichment Worker
After=network.target monad-processor.service
Requires=monad-processor.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/monad-tool/monad-explorer
ExecStart=/root/.nvm/versions/node/v22.14.0/bin/npm run worker:start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monad-token-enrichment-worker

[Install]
WantedBy=multi-user.target 