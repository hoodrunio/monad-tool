{
  "name": "squid-evm-template",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "start": "sqd process",
    "db:migrate": "sqd migration:apply",
    "db:create-migration": "sqd migration:generate",
    "processor:start": "node -r dotenv/config lib/main.js",
    "worker:start": "node -r dotenv/config lib/scripts/start-token-enrichment-worker.js",
    "worker:dev": "npm run build && npx ts-node src/scripts/start-token-enrichment-worker.ts",
    "worker:transaction:start": "node -r dotenv/config lib/scripts/start-transaction-enrichment-worker.js",
    "worker:transaction:dev": "npm run build && npx ts-node src/scripts/start-transaction-enrichment-worker.ts",
    "worker:contract:start": "node -r dotenv/config lib/scripts/start-contract-enrichment-worker.js",
    "worker:contract:dev": "npm run build && npx ts-node src/scripts/start-contract-enrichment-worker.ts",
    "query-node:start": "squid-graphql-server --dumb-cache in-memory --dumb-cache-ttl 1000 --dumb-cache-size 100 --dumb-cache-max-age 1000",
    "api:start": "node -r dotenv/config lib/api/server.js",
    "api:dev": "npx ts-node -r dotenv/config src/api/server.ts"
  },
  "dependencies": {
    "@subsquid/evm-abi": "^0.3.0",
    "@subsquid/evm-processor": "^1.27.2",
    "@subsquid/graphql-server": "^4.6.0",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.5.1",
    "@subsquid/util-internal": "^3.1.0",
    "@types/amqplib": "0.10.6",
    "@types/ioredis": "^5.0.0",
    "@types/winston": "^2.4.4",
    "amqplib": "^0.10.6",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.14.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "pg": "^8.12.0",
    "typeorm": "^0.3.17",
    "typeorm-naming-strategies": "^4.1.0",
    "viem": "^2.31.4",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "^3.1.0",
    "@subsquid/typeorm-codegen": "^2.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.10",
    "typescript": "~5.2.2"
  }
}
