# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monad-explorer

# RPC Configuration
RPC_MONAD_HTTP=https://testnet-rpc.monad.xyz

# Enhanced Token Processing Configuration
ENABLE_TOKEN_ENRICHMENT=true
ENABLE_ASYNC_PROCESSING=true

# RabbitMQ Configuration (for async processing)
RABBITMQ_URL=amqp://localhost:5672

# Worker Configuration
MAX_CONCURRENT_JOBS=3
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# GraphQL Server Configuration
PORT=4000

# Development Configuration
NODE_ENV=development 