# Monad Explorer Environment Configuration

# ================================
# DATABASE CONFIGURATION
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=squid_user
DB_PASS=your_secure_password
DB_NAME=squid
DATABASE_URL=postgres://squid_user:your_secure_password@localhost:5432/squid
# Database performance optimizations (20GB server)
DB_POOL_SIZE=50                     # Connection pool size (main processor)
DB_WORKER_POOL_SIZE=25              # Connection pool size (workers)
DB_MAX_QUERY_EXECUTION_TIME=20000   # Log slow queries (milliseconds)
DB_CONNECTION_TIMEOUT=15000         # Connection timeout (milliseconds)

# ================================
# RPC CONFIGURATION  
# ================================
RPC_MONAD_HTTP=https://testnet-rpc.monad.xyz
RPC_RATE_LIMIT=50                   # Requests per second
RPC_CAPACITY=100                    # Burst capacity
RPC_REQUEST_TIMEOUT=30000           # Request timeout (milliseconds)
RPC_MAX_BATCH_CALL_SIZE=100         # Max batch size

# ================================
# PROCESSOR CONFIGURATION
# ================================
START_BLOCK=23460742                # Starting block number
FINALITY_CONFIRMATION=2             # Block finality confirmation
ENABLE_HOT_BLOCKS=true              # Enable hot blocks support
ENABLE_TOKEN_ENRICHMENT=true        # Enable token metadata enrichment
ENABLE_ASYNC_PROCESSING=true       # Enable async workers (set true for production)
ENABLE_CONTRACT_DISCOVERY=true      # Enable contract discovery

# Performance optimizations (20GB server, 6 cores)
PROCESSOR_BATCH_SIZE=50             # Blocks per batch (high-performance)
ENTITY_CHUNK_SIZE=50000             # Entity chunk size for persistence
PARALLEL_CHUNKS=8                   # Parallel chunk processing

# ================================
# QUEUE CONFIGURATION (RabbitMQ)
# ================================
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=monad-explorer
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY=30000          # Retry delay (milliseconds)

# ================================
# WORKER CONFIGURATION (20GB server, 6 cores)
# ================================
WORKER_CONCURRENCY=8                # Worker concurrency (high-performance)
WORKER_RETRY_ATTEMPTS=3             # Worker retry attempts
WORKER_RETRY_DELAY=1000             # Worker retry delay (milliseconds)
WORKER_BATCH_SIZE=20                # Worker batch size (increased)
WORKER_PROCESSING_TIMEOUT=25000     # Worker processing timeout (milliseconds)

# ================================
# CACHE CONFIGURATION (Redis)
# ================================
CACHE_TYPE=redis                    # Cache type: redis or memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                     # Leave empty if no password
REDIS_DB=0
REDIS_KEY_PREFIX=monad:
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
CACHE_DEFAULT_TTL=300000            # Default TTL (5 minutes)
CACHE_MAX_SIZE=10000
CACHE_ENABLE_METRICS=true

# ================================
# NODE.JS PERFORMANCE (20GB server)
# ================================
NODE_OPTIONS=--max-old-space-size=16384  # 16GB memory limit (high-performance)

# ================================
# DEVELOPMENT/PRODUCTION
# ================================
NODE_ENV=production
LOG_LEVEL=info