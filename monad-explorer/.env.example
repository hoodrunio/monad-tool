# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monad-explorer

# Monad testnet RPC configuration
RPC_MONAD_HTTP=https://testnet-rpc.monad.xyz

# Block range
START_BLOCK=23460742
FINALITY_CONFIRMATION=2

# Async processing (set to true to enable background token enrichment)
ENABLE_ASYNC_PROCESSING=true
ENABLE_TOKEN_ENRICHMENT=true

# RabbitMQ configuration for queue processing
RABBITMQ_URL=amqp://localhost:5672

# Queue configuration
QUEUE_EXCHANGE=monad-explorer
QUEUE_TOKEN_ENRICHMENT=token-enrichment
QUEUE_INTERNAL_TRANSACTIONS=internal-transactions
QUEUE_DEAD_LETTER=dead-letter
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=30000
QUEUE_MAX_RECONNECT_ATTEMPTS=10
QUEUE_RECONNECT_DELAY=5000
QUEUE_PREFETCH_COUNT=10

# Token enrichment worker configuration
WORKER_CONCURRENCY=3
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=1000
WORKER_BATCH_SIZE=10
WORKER_PROCESSING_TIMEOUT=30000
STATS_LOG_INTERVAL=60000

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=monad:
REDIS_MAX_RETRIES=3

# RPC rate limiting
RPC_RATE_LIMIT=50
RPC_CAPACITY=100
RPC_REQUEST_TIMEOUT=30000
RPC_MAX_BATCH_CALL_SIZE=100

# Worker configuration
MAX_CONCURRENT_JOBS=3
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
HEALTH_CHECK_INTERVAL=30000

# GraphQL Server Configuration
PORT=4000

# Development Configuration
NODE_ENV=development 