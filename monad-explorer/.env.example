# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monad-explorer

# Monad testnet RPC configuration
RPC_MONAD_HTTP=https://testnet-rpc.monad.xyz

# Block range
START_BLOCK=23460742
FINALITY_CONFIRMATION=2

# Async processing (set to true to enable background token enrichment)
ENABLE_ASYNC_PROCESSING=true
ENABLE_TOKEN_ENRICHMENT=true

# RabbitMQ configuration for queue processing
RABBITMQ_URL=amqp://localhost:5672
INTERNAL_RABBITMQ_URL=amqp://rabbitmq:5672

# Queue configuration
QUEUE_EXCHANGE=monad-explorer
QUEUE_TOKEN_ENRICHMENT=token-enrichment
QUEUE_CONTRACT_ENRICHMENT=contract-enrichment
QUEUE_TRANSACTION_ENRICHMENT=transaction-enrichment
QUEUE_DAILY_STATS=daily-stats
QUEUE_INTERNAL_TRANSACTIONS=internal-transactions
QUEUE_DEAD_LETTER=dead-letter
QUEUE_COLD_STORAGE=cold-storage-ingest
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=30000
QUEUE_MAX_RECONNECT_ATTEMPTS=10
QUEUE_RECONNECT_DELAY=5000
QUEUE_PREFETCH_COUNT=10

# Token enrichment worker configuration
WORKER_CONCURRENCY=3
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=1000
WORKER_BATCH_SIZE=10
WORKER_PROCESSING_TIMEOUT=30000
STATS_LOG_INTERVAL=60000

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=monad:
REDIS_MAX_RETRIES=3
INTERNAL_REDIS_HOST=redis
INTERNAL_REDIS_PORT=6379

# RPC rate limiting
RPC_RATE_LIMIT=50
RPC_CAPACITY=100
RPC_REQUEST_TIMEOUT=30000
RPC_MAX_BATCH_CALL_SIZE=100

# Worker configuration
MAX_CONCURRENT_JOBS=3
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
HEALTH_CHECK_INTERVAL=30000

# Storage routing & cold tier configuration
ENABLE_COLD_STORAGE=false
ENABLE_COLD_READS=false
ENABLE_HOT_PRUNING=false
STORAGE_ROUTING_MODE=hot-only
HOT_BLOCK_WINDOW=4096
HOT_RETENTION_DAYS=7
COLD_STORAGE_QUEUE=cold-storage-ingest
COLD_STORAGE_BATCH_SIZE=5000
COLD_STORAGE_WORKER_CONCURRENCY=4
COLD_STORAGE_QUEUE_PREFETCH=8
COLD_READ_OFFSET_THRESHOLD=50000

# ClickHouse configuration (cold tier)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=monad_explorer
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_COMPRESSION=true
CLICKHOUSE_REQUEST_TIMEOUT_MS=30000
CLICKHOUSE_MAX_INSERT_BATCH_SIZE=10000
CLICKHOUSE_BLOCKS_TABLE=blocks_cold
CLICKHOUSE_TRANSACTIONS_TABLE=transactions_cold
CLICKHOUSE_LOGS_TABLE=logs_cold

# Hot tier pruning configuration
HOT_PRUNER_DRY_RUN=true
HOT_PRUNER_BATCH_SIZE=5000
HOT_PRUNER_RUN_INTERVAL_MINUTES=30
HOT_PRUNER_SAFETY_BUFFER_HOURS=6

# GraphQL Server Configuration
PORT=4000

# Development Configuration
NODE_ENV=development

# Database configuration for Docker
DB_NAME=squid
DB_PORT=5432
LOG_LEVEL=info
DB_USER=squid_user
DB_PASS=your_secure_password_here
DB_HOST=127.0.0.1
