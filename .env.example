# Monad Validator Analytics - Environment Configuration

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
API_PORT=4000
RPC_URL=https://rpc-testnet-2.monadinfra.com
STAKING_UPDATE_INTERVAL_MS=30000

# IPC Configuration (for real-time validator IP tracking)
IPC_SOCKET_PATH=/home/monad/monad-bft/controlpanel.sock
IPC_POLL_INTERVAL_MS=3600000

# Validator Registry Configuration
# Network: testnet | mainnet
VALIDATOR_NETWORK=testnet
# GitHub Personal Access Token (for higher rate limits)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
# Without token: 60 requests/hour, With token: 5000 requests/hour
GITHUB_TOKEN=your_github_token_here 
# ClickHouse Database Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=monad_analytics
CLICKHOUSE_MAX_CONNECTIONS=10
CLICKHOUSE_QUERY_TIMEOUT=30000
CLICKHOUSE_COMPRESSION=true

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=monad_redis_pass
REDIS_DB=0
REDIS_KEY_PREFIX=monad:
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_MEMORY_POLICY=allkeys-lru
REDIS_DEFAULT_TTL=300

# Log Processing Configuration
PROCESSING_BATCH_SIZE=1000
PROCESSING_BATCH_TIMEOUT=5000
PROCESSING_MAX_RETRIES=3
ENABLE_QC_PARSING=true
ENABLE_VOTE_CHAIN_ANALYSIS=true
ENABLE_GEOGRAPHIC_INTELLIGENCE=true
ENABLE_PARALLEL_PROCESSING=true
MAX_CONCURRENT_BATCHES=5

# Data Ingestion Configuration
INGESTION_BATCH_SIZE=500
INGESTION_BATCH_TIMEOUT=2000
INGESTION_MAX_CONCURRENT_BATCHES=3
INGESTION_ERROR_RETRY_ATTEMPTS=2
ENABLE_REAL_TIME_UPDATES=true
ENABLE_PERFORMANCE_MONITORING=true 

# Systemd Log Streaming Configuration (Production)
MONAD_BFT_SERVICE_NAME=monad-bft
MONAD_LEDGER_SERVICE_NAME=monad-ledger-tail
LOG_SINCE_WHEN=now
LOG_PRIORITY=info
STREAM_BUFFER_SIZE=100
STREAM_MAX_RESTART_ATTEMPTS=5
STREAM_RESTART_DELAY_MS=5000