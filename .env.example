# Monad Validator Analytics - Environment Configuration

# Application Settings
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# ClickHouse Database Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=monad_analytics
CLICKHOUSE_MAX_CONNECTIONS=10
CLICKHOUSE_QUERY_TIMEOUT=30000
CLICKHOUSE_COMPRESSION=true

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=monad:
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_MEMORY_POLICY=allkeys-lru
REDIS_DEFAULT_TTL=300

# Log Processing Configuration
PROCESSING_BATCH_SIZE=1000
PROCESSING_BATCH_TIMEOUT=5000
PROCESSING_MAX_RETRIES=3
ENABLE_QC_PARSING=true
ENABLE_VOTE_CHAIN_ANALYSIS=true
ENABLE_GEOGRAPHIC_INTELLIGENCE=true
ENABLE_PARALLEL_PROCESSING=true
MAX_CONCURRENT_BATCHES=5

# Data Ingestion Configuration
INGESTION_BATCH_SIZE=500
INGESTION_BATCH_TIMEOUT=2000
INGESTION_MAX_CONCURRENT_BATCHES=3
INGESTION_ERROR_RETRY_ATTEMPTS=2
ENABLE_REAL_TIME_UPDATES=true
ENABLE_PERFORMANCE_MONITORING=true 